{
    "name": "akirk/community-app-example",
    "description": "WordPress plugin that uses akirk/wp-app to create a web application",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4",
        "akirk/wp-app": "*@dev"
    },
    "repositories": {
        "wp-app": {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": false
            }
        }
    }
}
